{
  "name": "math-assist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harness": "python3 scripts/execute.py",
    "tdd:guard": "bash .codex/hooks/tdd-guard.sh",
    "validate:grade1": "node scripts/validate-grade1-problems.js",
    "validate:grade2": "node scripts/validate-grade2-problems.js",
    "validate:grade3": "node scripts/validate-grade3-problems.js",
    "validate:grade4": "node scripts/validate-grade4-problems.js",
    "validate:grade6": "node scripts/validate-grade6-templates.js",
    "validate:curriculum": "node scripts/validate-curriculum.js",
    "audit:missions": "node scripts/mission-bank-quality-report.js",
    "generate:grade5-geometry": "node scripts/generate-grade5-geometry-templates.js",
    "generate:grade5-average": "node scripts/generate-grade5-average-templates.js",
    "generate:grade5-estimate": "node scripts/generate-grade5-estimate-templates.js",
    "generate:grade5-fraction-addsub": "node scripts/generate-grade5-fraction-addsub-templates.js",
    "generate:grade5-fraction-simplify": "node scripts/generate-grade5-fraction-simplify-templates.js",
    "generate:grade5-decimalmul": "node scripts/generate-grade5-decimalmul-templates.js",
    "generate:grade5-divisor-multiple": "node scripts/generate-grade5-divisor-multiple-templates.js",
    "generate:grade5-fracmul": "node scripts/generate-grade5-fracmul-templates.js",
    "generate:grade5-mixedcalc": "node scripts/generate-grade5-mixedcalc-templates.js",
    "generate:grade5-pattern": "node scripts/generate-grade5-pattern-templates.js",
    "generate:grade6-fraction-division": "node scripts/generate-grade6-fraction-division-templates.js",
    "generate:grade6-fraction-decimal": "node scripts/generate-grade6-fraction-decimal-templates.js",
    "generate:grade6-decimal-division": "node scripts/generate-grade6-decimal-division-templates.js",
    "generate:grade6-proportion": "node scripts/generate-grade6-proportion-templates.js",
    "generate:grade5-rounding": "node scripts/generate-grade5-rounding-templates.js",
    "migrate:grade5-blueprints": "node scripts/migrate-grade5-blueprints.js",
    "validate:templates": "node scripts/validate-templates.js",
    "audit:problems": "node scripts/problem-quality-report.js",
    "promptfoo:problems": "mkdir -p public/reports out/promptfoo && promptfoo eval -c promptfooconfig.problem-quality.yaml --no-progress-bar -o public/reports/promptfoo-problem-quality.html -o out/promptfoo/problem-quality.json"
  },
  "dependencies": {
    "katex": "0.16.11",
    "next": "14.2.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/katex": "0.16.7",
    "@types/node": "20.17.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.21",
    "postcss": "8.5.1",
    "promptfoo": "^0.120.27",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
